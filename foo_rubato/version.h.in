#pragma once

// Generated from version.h.in by CMake - do not edit, and do not add the
// generated copy to git.
//
// The version has exactly one home: project(VERSION) in the top-level
// CMakeLists.txt. It used to be typed out again in DECLARE_COMPONENT_VERSION,
// and the two had already drifted by a patch level - the about box said 0.4.1
// while the release it shipped in was 0.4.2. Three readers now share this
// header: the about box, the attribution tags stamped into every analysed
// file, and scripts\build_release.ps1, which reads the version straight out of
// CMakeLists.txt to name the archive.

#define FOO_RUBATO_NAME    "Rubato BPM Analyzer"
#define FOO_RUBATO_VERSION "@PROJECT_VERSION@"

// The SDK release this was built against, read out of scripts\get_sdk.ps1,
// which is where the download and its checksum are pinned. The about box used
// to state this date itself, which is the same trap the version fell into: two
// copies, and only one of them updated when the SDK moved.
#define FOO_RUBATO_SDK_VERSION "@FOO_RUBATO_SDK_VERSION@"

// The value written to the BpmAlgorithm and KeyAlgorithm tags: which analysis
// produced the measurement, and which version of it. One string for both, the
// two fields being two measurements out of one component and one build.
// Shaped the way other taggers shape theirs - "<name>;v=<version>" - so one
// parser reads these and TuningAlgorithm alike, and so further
// semicolon-delimited parameters could be appended later without breaking a
// reader that only wants the name.
#define FOO_RUBATO_ALGORITHM_NAME "Rubato"
#define FOO_RUBATO_ALGORITHM      FOO_RUBATO_ALGORITHM_NAME ";v=" FOO_RUBATO_VERSION
