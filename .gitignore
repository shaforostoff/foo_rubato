# CMake build trees, the fetched SDK and WTL, and the packaged component.
/build
/external
/dist

# Finder, which now has a reason to visit: the macOS build writes a bundle,
# and Finder leaves one of these in every directory it is shown.
.DS_Store

# Visual Studio / CMake user state
/.vs
/CMakeUserPresets.json
*.user

# The analysis pipeline's scratch lives under /build, which is already ignored.
__pycache__/
*.pyc

# Generated from foo_rubato/version.h.in by CMake.
foo_rubato/version.h
